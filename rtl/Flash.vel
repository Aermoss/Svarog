enum FlashState { Idle, Transfer, Done }

module Flash(
    clk: in clock,
    rst: in reset,
    request: in bool,
    address: in u24,
    read_data: out reg u32 = 0,
    ready: out reg bool = false,
    flash_cs: out reg bool = true,
    flash_sck: out bool,
    flash_mosi: out bool,
    flash_miso: in bool
) {
    reg state: FlashState = FlashState::Idle;
    reg count: u6 = 0;
    reg phase: bool = false;
    reg stage: bool = false;
    reg tick: bool = false;
    reg transmit: u32 = 0;
    reg receive: u32 = 0;

    flash_sck = !flash_cs && phase;
    flash_mosi = transmit[31];

    seq {
        match state {
            FlashState::Idle => {
                ready <- false;

                if request {
                    flash_cs <- false;
                    transmit <- cat(0x03 as u8, address);
                    count <- 32;
                    phase <- false;
                    stage <- false;
                    tick <- false;
                    state <- FlashState::Transfer;
                } else {
                    flash_cs <- true;
                }
            },
            FlashState::Transfer => {
                tick <- !tick;

                if tick {
                    if !phase {
                        phase <- true;
                    } else {
                        receive <- cat(receive[30:0], flash_miso);
                        transmit <- cat(transmit[30:0], false);
                        phase <- false;

                        if count == 1 {
                            if !stage {
                                transmit <- 0;
                                count <- 32;
                                stage <- true;
                            } else {
                                state <- FlashState::Done;
                            }
                        } else {
                            count <- count - 1;
                        }
                    }
                }
            },
            FlashState::Done => {
                flash_cs <- true;
                read_data <- receive;
                ready <- true;
                state <- FlashState::Idle;
            }
        }
    }
}
