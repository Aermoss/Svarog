const UART_DIVISOR_DEFAULT: u16 = 703;

enum UartState { Idle, Start, Data, Stop }

module UART(
    clk: in clock,
    rst: in reset,
    fast: in bool,
    write: in bool,
    write_data: in u8,
    read: in bool,
    read_data: out u8,
    rx_ready: out bool,
    tx_busy: out bool,
    divisor_write: in bool,
    divisor_data: in u16,
    divisor: out reg u16 = UART_DIVISOR_DEFAULT,
    rx_pin: in bool,
    tx_pin: out reg bool = true
) {
    reg tx_state: UartState = UartState::Idle;
    reg tx_count: u16 = 0;
    reg tx_index: u3 = 0;
    reg tx_byte: u8 = 0;
    reg started: bool = false;

    reg rx_state: UartState = UartState::Idle;
    reg rx_count: u16 = 0;
    reg rx_index: u3 = 0;
    reg rx_byte: u8 = 0;
    reg rx_sync0: bool = true;
    reg rx_sync1: bool = true;

    reg fifo: [u8; 16];
    reg fifo_head: u4 = 0;
    reg fifo_tail: u4 = 0;
    reg fifo_count: u5 = 0;

    let start = write && tx_state == UartState::Idle && !started && !fast;
    let tx_last = tx_count >= divisor - 1;
    let rx_last = rx_count >= divisor - 1;
    let byte_received = rx_state == UartState::Stop && rx_last;
    let fifo_pop = read && fifo_count != 0;
    let fifo_push = byte_received && (fifo_count != 16 || fifo_pop);

    tx_busy = !fast && (tx_state != UartState::Idle || started);
    read_data = fifo[fifo_head];
    rx_ready = fifo_count != 0;

    seq(clk) {
        if fifo_push {
            fifo[fifo_tail] <- rx_byte;
        }
    }

    seq {
        if divisor_write {
            divisor <- divisor_data;
        }

        started <- start;

        match tx_state {
            UartState::Idle => {
                tx_pin <- true;
                tx_count <- 0;
                tx_index <- 0;

                if start {
                    tx_byte <- write_data;
                    tx_state <- UartState::Start;
                }
            },
            UartState::Start => {
                tx_pin <- false;

                if !tx_last {
                    tx_count <- tx_count + 1;
                } else {
                    tx_count <- 0;
                    tx_state <- UartState::Data;
                }
            },
            UartState::Data => {
                tx_pin <- tx_byte[tx_index];

                if !tx_last {
                    tx_count <- tx_count + 1;
                } else {
                    tx_count <- 0;

                    if tx_index != 7 {
                        tx_index <- tx_index + 1;
                    } else {
                        tx_index <- 0;
                        tx_state <- UartState::Stop;
                    }
                }
            },
            UartState::Stop => {
                tx_pin <- true;

                if !tx_last {
                    tx_count <- tx_count + 1;
                } else {
                    tx_count <- 0;
                    tx_state <- UartState::Idle;
                }
            }
        }

        rx_sync0 <- rx_pin;
        rx_sync1 <- rx_sync0;

        match rx_state {
            UartState::Idle => {
                rx_count <- 0;
                rx_index <- 0;

                if !rx_sync1 {
                    rx_state <- UartState::Start;
                }
            },
            UartState::Start => {
                if rx_count < (divisor >> 1) - 1 {
                    rx_count <- rx_count + 1;
                } else {
                    rx_count <- 0;
                    rx_state <- if !rx_sync1 { UartState::Data } else { UartState::Idle };
                }
            },
            UartState::Data => {
                if !rx_last {
                    rx_count <- rx_count + 1;
                } else {
                    rx_count <- 0;
                    rx_byte[rx_index] <- rx_sync1;

                    if rx_index != 7 {
                        rx_index <- rx_index + 1;
                    } else {
                        rx_index <- 0;
                        rx_state <- UartState::Stop;
                    }
                }
            },
            UartState::Stop => {
                if !rx_last {
                    rx_count <- rx_count + 1;
                } else {
                    rx_count <- 0;
                    rx_state <- UartState::Idle;
                }
            }
        }

        if fifo_push {
            fifo_tail <- fifo_tail + 1;
        }

        if fifo_pop {
            fifo_head <- fifo_head + 1;
        }

        if fifo_push && !fifo_pop {
            fifo_count <- fifo_count + 1;
        } else if fifo_pop && !fifo_push {
            fifo_count <- fifo_count - 1;
        }
    }
}
