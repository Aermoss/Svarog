#[include "std/io", "std/str", "std/vec", "std/file", "std/thrd", "std/time",
    "src/Common/File.zir", "src/Common/Endian.zir", "src/Common/Instruction.zir", "src/Emulator/SD.zir" : *]

class ConsoleInputRecord {
    pub event_type: u16 = 0,
    pub padding: u16 = 0,
    pub key_down: i32 = 0,
    pub repeat_count: u16 = 0,
    pub virtual_key: u16 = 0,
    pub scan_code: u16 = 0,
    pub character: u16 = 0,
    pub control_state: u32 = 0;

    ConsoleInputRecord(&mut this) {}
}

extern "C" {
    fn SetConsoleOutputCP(page: u32) -> i32;
    fn GetConsoleMode(hConsoleHandle: *mut void, lpMode: *mut u32) -> i32;
    fn SetConsoleMode(hConsoleHandle: *mut void, dwMode: u32) -> i32;
    fn ReadConsoleInputW(hConsoleInput: *mut void, lpBuffer: *mut ConsoleInputRecord, nLength: u32, lpNumberOfEventsRead: *mut u32) -> i32;
}

const UTF8_CODE_PAGE: u32 = 65001;
const KEY_EVENT: u16 = 1;
const ENABLE_PROCESSED_INPUT: u32 = 1;

fn KeySequence(virtual_key: u32) -> *i8 {
    match virtual_key {
        0x26 => "\x1B[A",
        0x28 => "\x1B[B",
        0x27 => "\x1B[C",
        0x25 => "\x1B[D",
        0x24 => "\x1B[H",
        0x23 => "\x1B[F",
        0x2E => "\x1B[3~",
        _ => null
    }
}

const CLK_FREQ: u32 = 54000000;
const CYCLES_PER_MS: u32 = CLK_FREQ / 1000;

const SDRAM_START: u32 = 0x40000000;
const SDRAM_MASK: u32 = 0x007FFFFF;
const TLB_ENTRIES: u32 = 64;
const MAX_CORES: u32 = 32;
const DEFAULT_CORES: u32 = 2;
const SPINLOCKS: u32 = 8;

const DEVICE_IPI_SEND: u32 = 0xFFA8;
const DEVICE_IPI_CLEAR: u32 = 0xFFA4;
const DEVICE_CORE_START: u32 = 0xFFA0;
const DEVICE_SPINLOCK_BASE: u32 = 0xFF80;

const INTERRUPT_TIMER: u32 = 1;
const INTERRUPT_UART: u32 = 2;
const INTERRUPT_SOFTWARE: u32 = 4;

enum Access: u32 {
    Fetch, Load, Store
}

class Core {
    pub id: u32,
    pub running: bool,
    pub waiting: bool,
    pub pc: u32,
    pub halted: bool,
    pub user_mode: bool,
    pub previous_user: bool,
    pub registers: *mut u32,
    pub instruction_counter: u32,
    pub interrupt_enable: bool,
    pub previous_interrupt_enable: bool,
    pub interrupt_mask: u32,
    pub trap_pc: u32,
    pub trap_cause: u32,
    pub trap_vector: u32,
    pub trap_scratch: u32,
    pub trap_address: u32,
    pub page_table_base: u32,
    pub address_space: u32,
    pub tlb_keys: *mut u32,
    pub tlb_entries: *mut u32,
    pub timer_compare: u32,
    pub ipi_pending: bool,
    pub reservation_valid: bool,
    pub reservation_address: u32;

    Core(&mut this, id: u32) {
        this.id = id;
        this.registers = new u32[32];
        this.tlb_keys = new u32[TLB_ENTRIES as usize];
        this.tlb_entries = new u32[TLB_ENTRIES as usize];
        this.Reset(0);
        this.running = id == 0;
    }

    ~Core(&mut this) {
        delete[] this.tlb_entries;
        delete[] this.tlb_keys;
        delete[] this.registers;
    }

    pub fn Reset(&mut this, entry: u32) {
        (this.pc, this.halted, this.waiting, this.user_mode, this.previous_user) = (entry, false, false, false, false);
        this.instruction_counter = 0;
        (this.interrupt_enable, this.previous_interrupt_enable, this.interrupt_mask) = (false, false, 0);
        (this.trap_pc, this.trap_cause, this.trap_vector, this.trap_scratch, this.trap_address) = (0, 0, 0, 0, 0);
        (this.page_table_base, this.address_space) = (0, 0);
        (this.timer_compare, this.ipi_pending) = (0, false);
        (this.reservation_valid, this.reservation_address) = (false, 0);

        for i in 0..TLB_ENTRIES {
            this.tlb_keys[i as usize] = 0;
        }

        for i in 0..32 {
            this.registers[i as usize] = 0;
        }
    }
}

class Emulator {
    pub quiet: bool,
    pub core_count: u32,
    core: *mut Core,
    cores: [*mut Core; 32],
    spinlocks: [bool; 8],
    bram: *mut u8,
    sdram: *mut u8,
    flash: *mut u8,
    cycle_counter: u64,
    uart_rx: u8,
    uart_rx_ready: bool,
    uart_mutex: Mutex,
    uart_changed: ConditionVariable,
    output_pending: String,
    output_needed: u32,
    pub sd: SDCard;

    Emulator(&mut this, quiet: bool, cores: u32) {
        this.quiet = quiet;
        this.core_count = cores;

        for i in 0..cores {
            this.cores[i as usize] = new Core(i);
        }

        this.core = this.cores[0];
        this.bram = new u8[16 * 1024];
        this.sdram = new u8[8 * 1024 * 1024];
        this.flash = new u8[8 * 1024 * 1024];

        for i in 0..(8 * 1024 * 1024) {
            this.flash[i as usize] = 0xFF;
        }

        this.Reset();
    }

    ~Emulator(&mut this) {
        delete[] this.flash;
        delete[] this.sdram;
        delete[] this.bram;

        for i in 0..this.core_count {
            delete this.cores[i as usize];
        }
    }

    pub fn Load(&mut this, path: &String, address: u32) -> bool {
        let (_, extension) = SplitExtension(path);

        if extension == ".hex" {
            this.LoadHexadecimal(path, address)
        } else if extension == ".bin" {
            this.LoadBinary(path, address)
        } else {
            false
        }
    }

    pub fn LoadHexadecimal(&mut this, path: &String, address: u32) -> bool {
        let content = File::ReadText(path).Unwrap();
        if content.Empty() { return false; }
        let mut offset: u32 = 0;

        for line in content.Split('\n') {
            if line.Empty() { continue; }
            let word = line.Strip().ToInteger(16).Unwrap() as u32;
            this.LoadWord(address + offset, word);
            offset += 4;
        }

        true
    }

    pub fn LoadBinary(&mut this, path: &String, address: u32) -> bool {
        let mut file = _File(path);
        if !file.Open(FileMode::Read) { return false; }
        let mut offset: u32 = 0;

        loop {
            let mut word: u32 = 0;
            if !file.ReadWords(&mut word, 1) { break; }
            this.LoadWord(address + offset, ByteSwap32(word));
            offset += 4;
        }

        true
    }

    fn LoadWord(&mut this, address: u32, value: u32) {
        if (address & 0xC0000000) == 0x80000000 {
            this.flash[(address & 0x7FFFFF) as usize] = (value & 0xFF) as u8;
            this.flash[((address + 1) & 0x7FFFFF) as usize] = ((value >> 8) & 0xFF) as u8;
            this.flash[((address + 2) & 0x7FFFFF) as usize] = ((value >> 16) & 0xFF) as u8;
            this.flash[((address + 3) & 0x7FFFFF) as usize] = ((value >> 24) & 0xFF) as u8;
        } else {
            this.WriteWord(address, value);
        }
    }

    pub fn Reset(&mut this) {
        this.cycle_counter = 0;
        this.sd.Reset();

        for i in 0..this.core_count {
            this.cores[i as usize]->Reset(0);
            this.cores[i as usize]->running = i == 0;
        }

        for i in 0..SPINLOCKS {
            this.spinlocks[i as usize] = false;
        }

        this.core = this.cores[0];
    }

    fn GetRegister(&this, index: u32) -> u32 {
        this.core->registers[index as usize]
    }

    fn SetRegister(&mut this, index: u32, value: u32) {
        if index != 0 {
            this.core->registers[index as usize] = value;
        }
    }

    fn IsDevice(&this, address: u32) -> bool {
        address == 0xFFFF || address == 0xFFFC || address == 0xFFF4 || address == 0xFFEC || address == 0xFFE8 || address == 0xFFE4 || address == 0xFFDC ||
            address == 0xFFB8 || address == 0xFFB4 || address == 0xFFB0 || address == DEVICE_IPI_SEND || address == DEVICE_CORE_START || this.IsSpinlock(address)
    }

    fn IsSpinlock(&this, address: u32) -> bool {
        address >= DEVICE_SPINLOCK_BASE && address < DEVICE_SPINLOCK_BASE + SPINLOCKS * 4 && (address & 3) == 0
    }

    fn IsUARTReady(&mut this) -> bool {
        this.uart_mutex.Lock();
        let ready = this.uart_rx_ready;
        this.uart_mutex.Unlock();
        ready
    }

    fn GetPendingInterrupts(&mut this, mask: u32) -> u32 {
        let uart: u32 = if (mask & INTERRUPT_UART) != 0 && this.core->id == 0 && this.IsUARTReady() { INTERRUPT_UART } else { 0 };
        let timer: u32 = if (mask & INTERRUPT_TIMER) != 0 && ((this.cycle_counter as u32 - this.core->timer_compare) as i32) >= 0 { INTERRUPT_TIMER } else { 0 };
        let software: u32 = if (mask & INTERRUPT_SOFTWARE) != 0 && this.core->ipi_pending { INTERRUPT_SOFTWARE } else { 0 };
        uart | timer | software
    }

    fn ReadCSR(&mut this, index: u32) -> u32 {
        if index == CSR::STATUS as u32 {
            let mut status: u32 = 0;
            if this.core->interrupt_enable { status |= STATUS_IE; }
            if this.core->previous_interrupt_enable { status |= STATUS_PIE; }
            if this.core->previous_user { status |= STATUS_PU; }
            status
        } else if index == CSR::IENABLE as u32 {
            this.core->interrupt_mask
        } else if index == CSR::IPENDING as u32 {
            this.GetPendingInterrupts(INTERRUPT_TIMER | INTERRUPT_UART | INTERRUPT_SOFTWARE)
        } else if index == CSR::EPC as u32 {
            this.core->trap_pc
        } else if index == CSR::CAUSE as u32 {
            this.core->trap_cause
        } else if index == CSR::VECTOR as u32 {
            this.core->trap_vector
        } else if index == CSR::SCRATCH as u32 {
            this.core->trap_scratch
        } else if index == CSR::BADADDR as u32 {
            this.core->trap_address
        } else if index == CSR::PTBASE as u32 {
            this.core->page_table_base
        } else if index == CSR::ASID as u32 {
            this.core->address_space
        } else if index == CSR::CYCLE as u32 {
            this.cycle_counter as u32
        } else if index == CSR::INSTRET as u32 {
            this.core->instruction_counter
        } else if index == CSR::TIME as u32 {
            (this.cycle_counter / CYCLES_PER_MS as u64) as u32
        } else if index == CSR::COREID as u32 {
            this.core->id
        } else {
            0
        }
    }

    fn WriteCSR(&mut this, index: u32, value: u32) {
        if index == CSR::STATUS as u32 {
            this.core->interrupt_enable = (value & STATUS_IE) != 0;
            this.core->previous_interrupt_enable = (value & STATUS_PIE) != 0;
            this.core->previous_user = (value & STATUS_PU) != 0;
        } else if index == CSR::IENABLE as u32 {
            this.core->interrupt_mask = value;
        } else if index == CSR::EPC as u32 {
            this.core->trap_pc = value;
        } else if index == CSR::CAUSE as u32 {
            this.core->trap_cause = value;
        } else if index == CSR::VECTOR as u32 {
            this.core->trap_vector = value;
        } else if index == CSR::SCRATCH as u32 {
            this.core->trap_scratch = value;
        } else if index == CSR::BADADDR as u32 {
            this.core->trap_address = value;
        } else if index == CSR::PTBASE as u32 {
            this.core->page_table_base = value;
        } else if index == CSR::ASID as u32 {
            this.core->address_space = value;
        } else if index == CSR::TLBFLUSH as u32 {
            this.FlushTLB();
        }
    }

    fn FlushTLB(&mut this) {
        for i in 0..TLB_ENTRIES {
            this.core->tlb_keys[i as usize] = 0;
        }
    }

    fn ReadTableEntry(&this, address: u32) -> u32 {
        let offset = (address & SDRAM_MASK & !3u32) as usize;
        let mut entry = this.sdram[offset] as u32;
        entry |= this.sdram[offset + 1] as u32 << 8;
        entry |= this.sdram[offset + 2] as u32 << 16;
        entry |= this.sdram[offset + 3] as u32 << 24;
        entry
    }

    fn Translate(&mut this, address: u32, access: Access, physical: *mut u32) -> bool {
        if address < WINDOW_START {
            *physical = address;
            return !this.core->user_mode;
        }

        let page = (address - WINDOW_START) >> PAGE_SHIFT;
        let key = 0x80000000 | ((this.core->address_space & 0xF) << 18) | page;
        let slot = (page & (TLB_ENTRIES - 1)) as usize;
        let mut entry: u32 = 0;

        if this.core->tlb_keys[slot] == key {
            entry = this.core->tlb_entries[slot];
        } else {
            if (this.core->page_table_base & PTBASE_VALID) == 0 {
                return false;
            }

            let root = SDRAM_START | (this.core->page_table_base & 0x007FFC00);
            let directory = this.ReadTableEntry(root + (page >> 10) * 4);

            if (directory & PTE_VALID) == 0 {
                return false;
            }

            let table = SDRAM_START | (directory & 0x007FF000);
            entry = this.ReadTableEntry(table + (page & 0x3FF) * 4);

            if (entry & PTE_VALID) == 0 {
                return false;
            }

            this.core->tlb_keys[slot] = key;
            this.core->tlb_entries[slot] = entry;
        }

        if access == Access::Store && (entry & PTE_WRITE) == 0 {
            return false;
        }

        if access == Access::Fetch && (entry & PTE_EXECUTE) == 0 {
            return false;
        }

        *physical = SDRAM_START | (entry & 0x007FF000) | (address & (PAGE_SIZE - 1));
        true
    }

    fn ClearReservations(&mut this, address: u32) {
        for i in 0..this.core_count {
            let core = this.cores[i as usize];

            if core->reservation_valid && (core->reservation_address & !3u32) == (address & !3u32) {
                core->reservation_valid = false;
            }
        }
    }

    fn AtomicResult(&this, operation: u32, old: u32, source: u32) -> u32 {
        match operation {
            1 => old + source,
            2 => old ^ source,
            3 => old & source,
            4 => old | source,
            5 => if (old as i32) < (source as i32) { old } else { source },
            6 => if (old as i32) > (source as i32) { old } else { source },
            7 => if old < source { old } else { source },
            8 => if old > source { old } else { source },
            _ => source
        }
    }

    fn Trap(&mut this, cause: u32, epc: u32, address: u32) {
        this.core->reservation_valid = false;
        (this.core->trap_pc, this.core->trap_cause, this.core->trap_address) = (epc, cause, address);
        (this.core->previous_interrupt_enable, this.core->interrupt_enable) = (this.core->interrupt_enable, false);
        (this.core->previous_user, this.core->user_mode) = (this.core->user_mode, false);
        this.core->pc = this.core->trap_vector;
    }

    fn IsCSROperation(&this, opcode: Opcode) -> bool {
        opcode as u32 >= Opcode::CSRRW as u32 && opcode as u32 <= Opcode::CSRRCI as u32
    }

    fn IsAllowed(&this, opcode: Opcode, csr: u32, writes: bool) -> bool {
        let read_only = csr >= FIRST_READ_ONLY_CSR && csr <= LAST_READ_ONLY_CSR;

        if this.IsCSROperation(opcode) && writes && read_only {
            return false;
        }

        if !this.core->user_mode {
            return true;
        }

        match opcode {
            Opcode::ERET | Opcode::WFI | Opcode::HLT => false,
            Opcode::CSRRW | Opcode::CSRRS | Opcode::CSRRC | Opcode::CSRRWI | Opcode::CSRRSI | Opcode::CSRRCI => !writes && read_only,
            _ => true
        }
    }

    fn ReadDevice(&mut this, address: u32) -> u32 {
        match address {
            0xFFFF => {
                this.uart_mutex.Lock();
                let mut result: u32 = 0;
                if this.uart_rx_ready {
                    result = this.uart_rx as u32;
                    this.uart_rx_ready = false;
                    this.uart_changed.Signal();
                }
                this.uart_mutex.Unlock();
                result * 0x01010101
            },
            0xFFFC => if this.IsUARTReady() { 1 } else { 0 },
            0xFFF4 => 0,
            0xFFE8 => this.cycle_counter as u32,
            0xFFE4 => this.core->instruction_counter,
            0xFFDC => this.core->timer_compare,
            0xFFB8 => this.sd.Received() as u32,
            0xFFB4 => this.sd.PortStatus(),
            0xFFB0 => this.sd.divisor,
            0xFFA8 => if this.core->ipi_pending { 1 } else { 0 },
            0xFFA0 => this.core_count,
            0xFFEC => (this.cycle_counter / CYCLES_PER_MS as u64) as u32,
            _ => {
                let index = ((address - DEVICE_SPINLOCK_BASE) / 4) as usize;
                if this.spinlocks[index] { return 0; }
                this.spinlocks[index] = true;
                1
            }
        }
    }

    fn ReadByte(&mut this, address: u32) -> u8 {
        if this.IsDevice(address) {
            ((this.ReadDevice(address) >> (8 * (address & 3))) & 0xFF) as u8
        } else if (address & 0xC0000000) == 0x80000000 {
            this.flash[(address & 0x7FFFFF) as usize]
        } else if (address & 0xC0000000) == 0x40000000 {
            this.sdram[(address & 0x7FFFFF) as usize]
        } else if address < 16384 {
            this.bram[address as usize]
        } else {
            0
        }
    }

    fn ReadHalf(&mut this, address: u32) -> u16 {
        if this.IsDevice(address) {
            ((this.ReadDevice(address) >> (16 * ((address >> 1) & 1))) & 0xFFFF) as u16
        } else {
            let mut result = this.ReadByte(address) as u32;
            result |= (this.ReadByte(address + 1) as u32 << 8);
            result as u16
        }
    }

    fn ReadWord(&mut this, address: u32) -> u32 {
        if this.IsDevice(address) {
            this.ReadDevice(address)
        } else {
            let mut result = this.ReadByte(address) as u32;
            result |= (this.ReadByte(address + 1) as u32 << 8);
            result |= (this.ReadByte(address + 2) as u32 << 16);
            result |= (this.ReadByte(address + 3) as u32 << 24);
            result
        }
    }

    fn WriteByte(&mut this, address: u32, value: u8) {
        if address == 0xFFFF {
            this.WriteOutput(value);
        } else if address == 0xFFB8 {
            this.sd.Transfer(value);
        } else if address == 0xFFB4 {
            this.sd.SetControl(value as u32);
        } else if address == 0xFFB0 {
            this.sd.divisor = if value == 0 { 1 } else { value as u32 };
        } else if address == 0xFFF0 {
            if !this.quiet {
                WriteLine("[LEDs: 0x" + String::FromInteger(value as u64, 16) + ']');
            }
        } else if (address & 0xC0000000) == 0x40000000 {
            this.ClearReservations(address);
            this.sdram[(address & 0x7FFFFF) as usize] = value;
        } else if address < 16384 {
            this.bram[address as usize] = value;
        }
    }

    fn WriteHalf(&mut this, address: u32, value: u16) {
        this.WriteByte(address, (value as u32 & 0xFF) as u8);
        this.WriteByte(address + 1, ((value as u32 >> 8) & 0xFF) as u8);
    }

    fn WriteWord(&mut this, address: u32, value: u32) {
        match address {
            0xFFE0 => {
                if !this.quiet {
                    WriteLine("[WS2812: RGB(0x" + String::FromInteger(value as u64, 16) + ")]");
                }
            },
            0xFFF8 => {
                if !this.quiet {
                    WriteLine("[UART Baud Rate: ~" + String::FromInteger((CLK_FREQ / value) as u64, 10) + ']');
                }
            },
            0xFFDC => {
                this.core->timer_compare = value;
            },
            0xFFA8 => {
                for i in 0..this.core_count {
                    if (value & (1u32 << i)) != 0 {
                        this.cores[i as usize]->ipi_pending = true;
                    }
                }
            },
            0xFFA4 => {
                this.core->ipi_pending = false;
            },
            0xFFA0 => {
                for i in 1..this.core_count {
                    let secondary = this.cores[i as usize];

                    if !secondary->running {
                        secondary->Reset(value);
                        secondary->running = true;
                    }
                }
            },
            _ => {
                if this.IsSpinlock(address) {
                    this.spinlocks[((address - DEVICE_SPINLOCK_BASE) / 4) as usize] = false;
                    return;
                }

                this.WriteByte(address, (value & 0xFF) as u8);
                this.WriteByte(address + 1, ((value >> 8) & 0xFF) as u8);
                this.WriteByte(address + 2, ((value >> 16) & 0xFF) as u8);
                this.WriteByte(address + 3, ((value >> 24) & 0xFF) as u8);
            }
        }
    }

    fn RunningCores(&this) -> u32 {
        let mut count: u32 = 0;

        for i in 0..this.core_count {
            if this.cores[i as usize]->running && !this.cores[i as usize]->halted {
                count += 1;
            }
        }

        count
    }

    fn WaitForInterrupt(&mut this) {
        if (this.core->interrupt_mask & (INTERRUPT_TIMER | INTERRUPT_UART | INTERRUPT_SOFTWARE)) == 0 { return; }

        if this.RunningCores() > 1 {
            this.core->waiting = true;
            return;
        }

        let timer_enabled = (this.core->interrupt_mask & INTERRUPT_TIMER) != 0;
        let uart_enabled = (this.core->interrupt_mask & INTERRUPT_UART) != 0 && this.core->id == 0;
        if this.core->ipi_pending && (this.core->interrupt_mask & INTERRUPT_SOFTWARE) != 0 { return; }
        if !timer_enabled && !uart_enabled { return; }
        let cycles_until_deadline: i64 = if timer_enabled { (this.core->timer_compare - this.cycle_counter as u32) as i32 as i64 } else { 0 };
        this.Block(timer_enabled, cycles_until_deadline, uart_enabled);
    }

    fn BlockAllCores(&mut this) {
        let mut has_deadline = false;
        let mut cycles_until_deadline: i64 = 0;
        let mut uart_enabled = false;

        for i in 0..this.core_count {
            let core = this.cores[i as usize];
            if !core->running || core->halted { continue; }

            if (core->interrupt_mask & INTERRUPT_SOFTWARE) != 0 && core->ipi_pending {
                return;
            }

            if (core->interrupt_mask & INTERRUPT_TIMER) != 0 {
                let remaining = (core->timer_compare - this.cycle_counter as u32) as i32 as i64;

                if !has_deadline || remaining < cycles_until_deadline {
                    cycles_until_deadline = remaining;
                }

                has_deadline = true;
            }

            if (core->interrupt_mask & INTERRUPT_UART) != 0 && core->id == 0 {
                uart_enabled = true;
            }
        }

        if !has_deadline && !uart_enabled {
            return;
        }

        this.Block(has_deadline, cycles_until_deadline, uart_enabled);
    }

    fn Block(&mut this, has_deadline: bool, cycles_until_deadline: i64, uart_enabled: bool) {
        let mut elapsed_cycles: u64 = 0;
        this.uart_mutex.Lock();
        let started = Instant::Now();

        while (!uart_enabled || !this.uart_rx_ready) && (!has_deadline || (cycles_until_deadline > 0 && elapsed_cycles < cycles_until_deadline as u64)) {
            let timeout = if has_deadline {
                ((cycles_until_deadline as u64 - elapsed_cycles + CYCLES_PER_MS as u64 - 1) / CYCLES_PER_MS as u64) as u32
            } else { INFINITE };

            this.uart_changed.Wait(&mut this.uart_mutex, timeout);
            elapsed_cycles = (started.Elapsed() * CLK_FREQ as f64) as u64;
        }

        this.uart_mutex.Unlock();
        this.cycle_counter += elapsed_cycles;
    }

    fn AllWaiting(&this) -> bool {
        for i in 0..this.core_count {
            let core = this.cores[i as usize];

            if core->running && !core->halted && !core->waiting {
                return false;
            }
        }

        true
    }

    fn Tick(&mut this) {
        if this.core_count > 1 && this.cores[1]->running {
            if this.AllWaiting() {
                this.BlockAllCores();
            }

            for i in 0..this.core_count {
                this.core = this.cores[i as usize];

                if this.core->running && !this.core->halted {
                    this.Step();
                }
            }

            this.core = this.cores[0];
        } else {
            this.Step();
        }

        this.cycle_counter += 1;
    }

    fn Step(&mut this) {
        if this.core->waiting {
            if this.GetPendingInterrupts(this.core->interrupt_mask) == 0 {
                return;
            }

            this.core->waiting = false;
        }

        let interrupts = if this.core->interrupt_enable {
            this.GetPendingInterrupts(this.core->interrupt_mask)
        } else { 0 };

        if interrupts != 0 {
            let cause = if (interrupts & INTERRUPT_TIMER) != 0 {
                TrapCause::Timer as u32
            } else if (interrupts & INTERRUPT_UART) != 0 {
                TrapCause::UART as u32
            } else {
                TrapCause::Software as u32
            };

            this.Trap(cause, this.core->pc, 0);
        }

        let mut fetch_address: u32 = 0;

        if !this.Translate(this.core->pc, Access::Fetch, &mut fetch_address) {
            this.Trap(TrapCause::InstructionFault as u32, this.core->pc, this.core->pc);
            return;
        }

        let word = this.ReadWord(fetch_address);
        let raw_opcode = word >> OPCODE_SHIFT;
        let opcode = raw_opcode as Opcode;
        let (reg0, reg1, reg2) = ((word >> REG0_SHIFT) & 0x1F, (word >> REG1_SHIFT) & 0x1F, (word >> REG2_SHIFT) & 0x1F);
        let (imm16, imm21, imm26) = (word & IMM16_MASK, word & IMM21_MASK, word & IMM26_MASK);
        let (simm16, simm21, simm26) = (((imm16 as i32) ^ (1 << 15)) - (1 << 15), ((imm21 as i32) ^ (1 << 20)) - (1 << 20), ((imm26 as i32) ^ (1 << 25)) - (1 << 25));
        let writes_csr = opcode == Opcode::CSRRW || opcode == Opcode::CSRRWI || reg1 != 0;

        if (raw_opcode > Opcode::FENCE as u32 && raw_opcode != Opcode::HLT as u32) || !this.IsAllowed(opcode, imm16, writes_csr) {
            this.Trap(TrapCause::IllegalInstruction as u32, this.core->pc, word);
            return;
        }

        let is_load = match opcode {
            Opcode::LB | Opcode::LBU | Opcode::LH | Opcode::LHU | Opcode::LW => true,
            _ => false
        };

        let is_store = match opcode {
            Opcode::SB | Opcode::SH | Opcode::SW | Opcode::SC | Opcode::AMO => true,
            _ => false
        };

        let is_atomic = opcode == Opcode::LR || opcode == Opcode::SC || opcode == Opcode::AMO;
        let mut address: u32 = 0;

        if is_load || is_store || is_atomic {
            let virtual_address = if is_atomic { this.GetRegister(reg1) } else { (this.GetRegister(reg1) as i32 + simm16) as u32 };

            if !this.Translate(virtual_address, if is_store { Access::Store } else { Access::Load }, &mut address) {
                this.Trap(if is_store { TrapCause::StoreFault as u32 } else { TrapCause::LoadFault as u32 }, this.core->pc, virtual_address);
                return;
            }
        }

        let mut next_pc = this.core->pc + 4;

        match opcode {
            Opcode::NOP => {},
            Opcode::LB => {
                this.SetRegister(reg0, this.ReadByte(address) as i8 as u32);
            },
            Opcode::LBU => {
                this.SetRegister(reg0, this.ReadByte(address) as u32);
            },
            Opcode::LH => {
                this.SetRegister(reg0, this.ReadHalf(address) as i16 as u32);
            },
            Opcode::LHU => {
                this.SetRegister(reg0, this.ReadHalf(address) as u32);
            },
            Opcode::LW => {
                this.SetRegister(reg0, this.ReadWord(address));
            },
            Opcode::LUI => {
                this.SetRegister(reg0, imm21 << 11);
            },
            Opcode::AUIPC => {
                this.SetRegister(reg0, this.core->pc + (imm21 << 11));
            },
            Opcode::SB => {
                this.WriteByte(address, (this.GetRegister(reg0) & 0xFF) as u8);
            },
            Opcode::SH => {
                this.WriteHalf(address, (this.GetRegister(reg0) & 0xFFFF) as u16);
            },
            Opcode::SW => {
                this.WriteWord(address, this.GetRegister(reg0));
            },
            Opcode::B => {
                next_pc = (this.core->pc as i32 + (simm26 << 2)) as u32;
            },
            Opcode::BR => {
                next_pc = this.GetRegister(reg0);
            },
            Opcode::BL => {
                this.SetRegister(reg0, this.core->pc + 4);
                next_pc = (this.core->pc as i32 + (simm21 << 2)) as u32;
            },
            Opcode::BLR => {
                this.SetRegister(reg0, this.core->pc + 4);
                next_pc = this.GetRegister(reg1);
            },
            Opcode::BEQ => {
                if this.GetRegister(reg0) == this.GetRegister(reg1) {
                    next_pc = (this.core->pc as i32 + (simm16 << 2)) as u32;
                }
            },
            Opcode::BNE => {
                if this.GetRegister(reg0) != this.GetRegister(reg1) {
                    next_pc = (this.core->pc as i32 + (simm16 << 2)) as u32;
                }
            },
            Opcode::BLT => {
                if (this.GetRegister(reg0) as i32) < (this.GetRegister(reg1) as i32) {
                    next_pc = (this.core->pc as i32 + (simm16 << 2)) as u32;
                }
            },
            Opcode::BLTU => {
                if this.GetRegister(reg0) < this.GetRegister(reg1) {
                    next_pc = (this.core->pc as i32 + (simm16 << 2)) as u32;
                }
            },
            Opcode::BGE => {
                if (this.GetRegister(reg0) as i32) >= (this.GetRegister(reg1) as i32) {
                    next_pc = (this.core->pc as i32 + (simm16 << 2)) as u32;
                }
            },
            Opcode::BGEU => {
                if this.GetRegister(reg0) >= this.GetRegister(reg1) {
                    next_pc = (this.core->pc as i32 + (simm16 << 2)) as u32;
                }
            },
            Opcode::SLT => {
                this.SetRegister(reg0, if this.GetRegister(reg1) as i32 < this.GetRegister(reg2) as i32 { 1 } else { 0 });
            },
            Opcode::SLTU => {
                this.SetRegister(reg0, if this.GetRegister(reg1) < this.GetRegister(reg2) { 1 } else { 0 });
            },
            Opcode::SLTI => {
                this.SetRegister(reg0, if this.GetRegister(reg1) as i32 < simm16 { 1 } else { 0 });
            },
            Opcode::SLTIU => {
                this.SetRegister(reg0, if this.GetRegister(reg1) < imm16 { 1 } else { 0 });
            },
            Opcode::ADD => {
                this.SetRegister(reg0, this.GetRegister(reg1) + this.GetRegister(reg2));
            },
            Opcode::ADDI => {
                this.SetRegister(reg0, this.GetRegister(reg1) + simm16 as u32);
            },
            Opcode::SUB => {
                this.SetRegister(reg0, this.GetRegister(reg1) - this.GetRegister(reg2));
            },
            Opcode::SUBI => {
                this.SetRegister(reg0, this.GetRegister(reg1) - simm16 as u32);
            },
            Opcode::MUL => {
                this.SetRegister(reg0, this.GetRegister(reg1) * this.GetRegister(reg2));
            },
            Opcode::MULH => {
                let product = (this.GetRegister(reg1) as i32 as i64) * (this.GetRegister(reg2) as i32 as i64);
                this.SetRegister(reg0, (product >> 32) as u32);
            },
            Opcode::MULHSU => {
                let product = (this.GetRegister(reg1) as i32 as i64) * (this.GetRegister(reg2) as i64);
                this.SetRegister(reg0, (product >> 32) as u32);
            },
            Opcode::MULHU => {
                let product = (this.GetRegister(reg1) as i64) * (this.GetRegister(reg2) as i64);
                this.SetRegister(reg0, (product >> 32) as u32);
            },
            Opcode::DIV => {
                let (dividend, divisor) = (this.GetRegister(reg1) as i32, this.GetRegister(reg2) as i32);
                this.SetRegister(reg0, if divisor == 0 { 0xFFFFFFFF } else { (dividend / divisor) as u32 });
            },
            Opcode::DIVU => {
                let (dividend, divisor) = (this.GetRegister(reg1), this.GetRegister(reg2));
                this.SetRegister(reg0, if divisor == 0 { 0xFFFFFFFF } else { dividend / divisor });
            },
            Opcode::REM => {
                let (dividend, divisor) = (this.GetRegister(reg1) as i32, this.GetRegister(reg2) as i32);
                this.SetRegister(reg0, if divisor == 0 { dividend as u32 } else { (dividend % divisor) as u32 });
            },
            Opcode::REMU => {
                let (dividend, divisor) = (this.GetRegister(reg1), this.GetRegister(reg2));
                this.SetRegister(reg0, if divisor == 0 { dividend } else { dividend % divisor });
            },
            Opcode::AND => {
                this.SetRegister(reg0, this.GetRegister(reg1) & this.GetRegister(reg2));
            },
            Opcode::ANDI => {
                this.SetRegister(reg0, this.GetRegister(reg1) & imm16);
            },
            Opcode::OR => {
                this.SetRegister(reg0, this.GetRegister(reg1) | this.GetRegister(reg2));
            },
            Opcode::ORI => {
                this.SetRegister(reg0, this.GetRegister(reg1) | imm16);
            },
            Opcode::XOR => {
                this.SetRegister(reg0, this.GetRegister(reg1) ^ this.GetRegister(reg2));
            },
            Opcode::XORI => {
                this.SetRegister(reg0, this.GetRegister(reg1) ^ imm16);
            },
            Opcode::SLL => {
                this.SetRegister(reg0, this.GetRegister(reg1) << (this.GetRegister(reg2) & 0x1F));
            },
            Opcode::SLLI => {
                this.SetRegister(reg0, this.GetRegister(reg1) << (imm16 & 0x1F));
            },
            Opcode::SRL => {
                this.SetRegister(reg0, this.GetRegister(reg1) >> (this.GetRegister(reg2) & 0x1F));
            },
            Opcode::SRLI => {
                this.SetRegister(reg0, this.GetRegister(reg1) >> (imm16 & 0x1F));
            },
            Opcode::SRA => {
                this.SetRegister(reg0, ((this.GetRegister(reg1) as i32) >> ((this.GetRegister(reg2) & 0x1F) as i32)) as u32);
            },
            Opcode::SRAI => {
                this.SetRegister(reg0, ((this.GetRegister(reg1) as i32) >> ((imm16 & 0x1F) as i32)) as u32);
            },
            Opcode::CSRRW | Opcode::CSRRS | Opcode::CSRRC | Opcode::CSRRWI | Opcode::CSRRSI | Opcode::CSRRCI => {
                let old = this.ReadCSR(imm16);
                let source = if opcode as u32 >= Opcode::CSRRWI as u32 { reg1 } else { this.GetRegister(reg1) };

                if writes_csr {
                    let value = match opcode {
                        Opcode::CSRRW | Opcode::CSRRWI => source,
                        Opcode::CSRRS | Opcode::CSRRSI => old | source,
                        _ => old & !source
                    };

                    this.WriteCSR(imm16, value);
                }

                this.SetRegister(reg0, old);
            },
            Opcode::ECALL => {
                this.Trap(TrapCause::SystemCall as u32, this.core->pc + 4, 0);
                this.core->instruction_counter += 1;
                return;
            },
            Opcode::EBREAK => {
                this.Trap(TrapCause::Breakpoint as u32, this.core->pc, this.core->pc);
                return;
            },
            Opcode::ERET => {
                this.core->reservation_valid = false;
                next_pc = this.core->trap_pc;
                (this.core->interrupt_enable, this.core->previous_interrupt_enable) = (this.core->previous_interrupt_enable, true);
                (this.core->user_mode, this.core->previous_user) = (this.core->previous_user, false);
            },
            Opcode::WFI => {
                this.WaitForInterrupt();
            },
            Opcode::LR => {
                let value = this.ReadWord(address);
                (this.core->reservation_valid, this.core->reservation_address) = (true, address);
                this.SetRegister(reg0, value);
            },
            Opcode::SC => {
                let success = this.core->reservation_valid && (this.core->reservation_address & !3u32) == (address & !3u32);
                if success { this.WriteWord(address, this.GetRegister(reg2)); }
                this.core->reservation_valid = false;
                this.SetRegister(reg0, if success { 0 } else { 1 });
            },
            Opcode::AMO => {
                let old = this.ReadWord(address);
                this.WriteWord(address, this.AtomicResult((word >> ATOMIC_SHIFT) & ATOMIC_MASK, old, this.GetRegister(reg2)));
                this.SetRegister(reg0, old);
            },
            Opcode::FENCE => {},
            Opcode::HLT => {
                this.core->halted = true;
            }
        }

        this.core->pc = next_pc;
        this.core->instruction_counter += 1;
    }

    fn WriteOutput(&mut this, value: u8) {
        if (value & 0xC0) == 0x80 && this.output_needed > 0 {
            this.output_pending += value as i8;
            this.output_needed -= 1;

            if this.output_needed == 0 {
                Write(this.output_pending);
                this.output_pending.Clear();
            }

            return;
        }

        if !this.output_pending.Empty() {
            Write(this.output_pending);
            this.output_pending.Clear();
        }

        this.output_needed = if value >= 0xF0 && value < 0xF8 { 3 } else if value >= 0xE0 && value < 0xF0 { 2 } else if value >= 0xC0 && value < 0xE0 { 1 } else { 0 };

        if this.output_needed > 0 {
            this.output_pending += value as i8;
        } else {
            Write((value as i8).ToString());
        }
    }

    fn ReceiveCode(&mut this, code: u32) {
        if code < 0x80 {
            this.Receive(code as u8);
        } else if code < 0x800 {
            this.Receive((0xC0 | (code >> 6)) as u8);
            this.Receive((0x80 | (code & 0x3F)) as u8);
        } else if code < 0x10000 {
            this.Receive((0xE0 | (code >> 12)) as u8);
            this.Receive((0x80 | ((code >> 6) & 0x3F)) as u8);
            this.Receive((0x80 | (code & 0x3F)) as u8);
        } else {
            this.Receive((0xF0 | (code >> 18)) as u8);
            this.Receive((0x80 | ((code >> 12) & 0x3F)) as u8);
            this.Receive((0x80 | ((code >> 6) & 0x3F)) as u8);
            this.Receive((0x80 | (code & 0x3F)) as u8);
        }
    }

    fn Receive(&mut this, character: u8) {
        this.uart_mutex.Lock();

        while this.uart_rx_ready {
            this.uart_changed.Wait(&mut this.uart_mutex);
        }

        this.uart_rx = character;
        this.uart_rx_ready = true;
        this.uart_changed.Signal();
        this.uart_mutex.Unlock();
    }

    fn Receive(&mut this, mut sequence: *i8) {
        while *sequence != '\0' {
            this.Receive(*sequence as u8);
            sequence += 1;
        }
    }

    fn ReceiveKey(&mut this, record: &ConsoleInputRecord, high_surrogate: &mut u32) {
        let sequence = KeySequence(record.virtual_key as u32);

        if sequence != null {
            this.Receive(sequence);
            return;
        }

        let character = record.character as u32;

        if character >= 0xD800 && character < 0xDC00 {
            high_surrogate = character;
        } else if character >= 0xDC00 && character < 0xE000 {
            if high_surrogate != 0 {
                this.ReceiveCode(0x10000 + ((high_surrogate - 0xD800) << 10) + (character & 0x3FF));
            }

            high_surrogate = 0;
        } else if character != 0 {
            high_surrogate = 0;
            this.ReceiveCode(character);
        }
    }

    fn UARTThread(&mut this) {
        let input = CreateFileA("CONIN$", GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, null, OPEN_EXISTING, 0, null);
        let mut high_surrogate: u32 = 0;

        loop {
            let mut mode: u32 = 0;
            let has_mode = GetConsoleMode(input, &mut mode) != 0;

            if has_mode {
                SetConsoleMode(input, mode & !ENABLE_PROCESSED_INPUT);
            }

            let mut record = ConsoleInputRecord();
            let mut count: u32 = 0;
            let read = ReadConsoleInputW(input, &mut record, 1, &mut count) != 0;

            if has_mode {
                SetConsoleMode(input, mode);
            }

            if !read {
                return;
            }

            if count == 0 || record.event_type != KEY_EVENT || record.key_down == 0 {
                continue;
            }

            let repeats = if record.repeat_count == 0 { 1 } else { record.repeat_count as u32 };

            for _ in 0..repeats {
                this.ReceiveKey(record, high_surrogate);
            }
        }
    }

    pub fn Emulate(&mut this) {
        SetConsoleOutputCP(UTF8_CODE_PAGE);
        let mut uart_thread = Thread(Emulator::UARTThread as ThreadFunction, this);
        uart_thread.Detach();

        while !this.cores[0]->halted {
            this.Tick();
        }
    }
}
